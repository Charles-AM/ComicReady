{
  "name": "comicready",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "catalog:migration": "node --experimental-strip-types scripts/generate-reviewed-catalog-migration.mjs",
    "lint": "eslint . --max-warnings=0",
